# .env.example — copy to .env.local; never commit real keys.
#
# --- AI provider (any OpenAI-compatible endpoint, local or cloud) ---
# Keys can also be entered live in the web UI (02 · AI Provider / 03 · Keys);
# values saved there are held in server memory and pushed into the environment.
API_KEY=none
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3
# Used by the web UI chat + provider flow when set:
# HARNESS_LLM_BASE_URL=http://localhost:11434/v1
# HARNESS_LLM_API_KEY_ENV=API_KEY

# --- Optional MCP / tool keys (all optional — free built-ins need nothing) ---
# BRAVE_API_KEY=            # only if you enable the Brave Search MCP preset
# SERPER_API_KEY=           # only if you wire a manual serper.dev endpoint
